# NEXT_PUBLIC_API_URL must be the API origin (scheme + host, no /api suffix).
# The API client appends /api/... to every endpoint path automatically.

# NEXT_PUBLIC_SITE_URL is used for Open Graph metadata (absolute URL resolution).
# Set this to the public-facing origin of the frontend.

# local dev
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DOCS_URL=http://localhost:3001
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# production
NEXT_PUBLIC_API_URL=https://54.81.1.130.nip.io
NEXT_PUBLIC_DOCS_URL=https://54.81.1.130.nip.io/docs
NEXT_PUBLIC_SITE_URL=https://54.81.1.130.nip.io
